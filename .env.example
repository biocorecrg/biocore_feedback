# Slack Incoming Webhook URL
# Replace with your incoming webhook from https://api.slack.com/apps
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE

# Server Port (default: 8080)
PORT=8080

# Allowed CORS origins (comma-separated, wildcard '*' supported or specific domains)
# Example: https://*.crg.es,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_ORIGINS=*

# Rate limit per IP (requests per minute)
RATE_LIMIT_PER_MINUTE=10
